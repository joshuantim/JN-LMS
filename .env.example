# Server Configuration
PORT=5000
NODE_ENV=development
CLIENT_URL=http://localhost:5173
SERVER_URL=http://localhost:5000

# Database (PostgreSQL with pgvector)
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/jn_lms?schema=public"

# Redis Cache & Background Jobs
REDIS_URL="redis://localhost:6379"

# Authentication & Security
JWT_SECRET="jn_lms_super_secret_jwt_access_key_2026_dev_min32chars"
JWT_REFRESH_SECRET="jn_lms_super_secret_jwt_refresh_key_2026_dev_min32chars"
JWT_EXPIRES_IN="15m"
JWT_REFRESH_EXPIRES_IN="7d"

# AI Provider Configuration (OpenAI, Gemini, Anthropic, or Mock for development)
AI_PROVIDER="openai"
AI_API_KEY="your-api-key-here"
AI_MODEL="gpt-4o-mini"
AI_EMBEDDING_MODEL="text-embedding-3-small"

# Storage Configuration (local | s3 | r2 | supabase)
STORAGE_PROVIDER="local"
STORAGE_LOCAL_DIR="./uploads"
STORAGE_ENDPOINT=""
STORAGE_ACCESS_KEY=""
STORAGE_SECRET_KEY=""
STORAGE_BUCKET="jn-lms-documents"
STORAGE_REGION="auto"
